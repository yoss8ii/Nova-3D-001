// Cloudflare Workers configuration (comments are allowed in .jsonc)
{
  "name": "nova",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/produits", "/produits/*", "/produit", "/produit/*", "/panier", "/panier/*", "/a-propos", "/a-propos/*", "/suivi", "/suivi/*", "/sur-mesure", "/sur-mesure/*"]
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "12f7c690b59643c88e67461b8fecd5d2",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/nova3d"
    }
  ],

  // Page « Bientôt disponible » : texts + ON/OFF stockés dans KV
  "kv_namespaces": [{ "binding": "NOVA_KV", "id": "35ec2d5954734d3092b7b690b63336c3" }],

  "vars": {
    "ORDERS_ENABLED": "true",
    "TIMEZONE": "Africa/Tunis",
    "OWNER_EMAIL": "nova.3d.com.tn@gmail.com"
  }

  "observability": {
      "enabled": false
  },
}
